<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BikeRaceSystem.UI.Maui.Views.Extended.Statistics.ExtendedStatisticsPage"
             Title="ExtendedStatisticsPage">
    <ScrollView x:Name="AutoScrollView">
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding TodayRaces}">
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="10" Padding="10" BackgroundColor="#222" CornerRadius="10">
                        <VerticalStackLayout>
                            <Label Text="{Binding RaceName}" FontSize="28" TextColor="White"/>
                            <Label Text="{Binding Date}" FontSize="16" TextColor="Gray"/>
                            <Label Text="{Binding Distance}" FontSize="16" TextColor="Gray"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>