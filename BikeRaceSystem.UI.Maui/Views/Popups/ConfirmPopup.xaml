<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="BikeRaceSystem.UI.Maui.Views.Popups.ConfirmPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Color="Transparent"
    CanBeDismissedByTappingOutsideOfPopup="False">

    <Border BackgroundColor="White" Stroke="#DCE5DF" StrokeThickness="1"
            StrokeShape="RoundRectangle 20" Padding="24" Margin="12"
            HorizontalOptions="Center" VerticalOptions="Center">
        <Grid RowDefinitions="*,Auto" RowSpacing="20">
            <ScrollView Grid.Row="0" MaximumHeightRequest="150">
                <Label Text="{Binding Message}" FontSize="18" TextColor="#183B2B"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                       LineBreakMode="WordWrap" />
            </ScrollView>
            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="{Binding YesLabel}" Command="{Binding YesCommand}"
                        BackgroundColor="#245A40" TextColor="White" />
                <Button Grid.Column="1" Text="{Binding NoLabel}" Command="{Binding NoCommand}"
                        BackgroundColor="#EAF3EE" TextColor="#173D2D" />
            </Grid>
        </Grid>
    </Border>
</toolkit:Popup>
